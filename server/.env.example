# Supabase Postgres — use the transaction pooler URL (port 6543) for Vercel
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# The Odds API (the-odds-api.com) — free tier
ODDS_API_KEY=

# Shared secret pg_cron sends in Authorization: Bearer <secret>
CRON_SECRET=

# Secret for /api/admin/override (x-admin-secret header)
ADMIN_SECRET=

# NEVER 'true' in production. Enables the X-Debug-Now header for tests.
DEBUG_MODE=false

# Optional: force the season year (otherwise inferred from the date)
# SEASON_YEAR=2026
